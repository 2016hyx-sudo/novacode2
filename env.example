# ============================================================
# NovaCode .env configuration
# Copy to .env and fill in your values.
# ============================================================

# LLM provider: openai | anthropic
NOVACODE_PROVIDER=openai

# Default model for the selected provider
NOVACODE_MODEL=gpt-4o-mini
# Max output tokens per LLM response. Thinking/reasoning tokens share this
# budget with the final text. For DeepSeek v4 the model cap is 384K; the
# legacy 8192 limit belongs to older deepseek-chat models.
NOVACODE_MAX_TOKENS=4096

# Thinking/reasoning effort for main-agent calls: none | low | high | max
# (empty = provider default, thinking on). "none" disables thinking entirely.
NOVACODE_REASONING_EFFORT=
# Effort for secondary calls (subagents, context folding): none | low | high | max
NOVACODE_SECONDARY_REASONING_EFFORT=none

# OpenAI
OPENAI_API_KEY=sk-your-openai-key
NOVACODE_BASE_URL=

# Anthropic (set NOVACODE_PROVIDER=anthropic to use these)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
# Optional Anthropic base URL
# NOVACODE_BASE_URL=

# Structured context / checkpoint-resume storage
NOVACODE_STRUCTURED_CONTEXT=false
NOVACODE_AGENT_DIR=.agent
